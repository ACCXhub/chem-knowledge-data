{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accxhub.github.io/chem-knowledge-data/thermochemistry/species_phase_fact.schema.json",
  "title": "Thermochemistry Species Phase Fact",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","species_id","standard_phase","allowed_teaching_phases","thermochemistry_available_phases","reference_conditions","phase_conditions","source_refs","status"],
  "properties": {
    "id": {"type":"string","minLength":1},
    "species_id": {"type":"string","minLength":1},
    "standard_phase": {"enum":["s","l","g","aq"]},
    "allowed_teaching_phases": {"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["s","l","g","aq"]}},
    "thermochemistry_available_phases": {"type":"array","uniqueItems":true,"items":{"enum":["s","l","g","aq"]}},
    "reference_conditions": {
      "type":"object","additionalProperties":false,
      "required":["temperature_k","standard_pressure_bar"],
      "properties":{"temperature_k":{"type":"number","exclusiveMinimum":0},"standard_pressure_bar":{"type":"number","exclusiveMinimum":0}}
    },
    "phase_conditions": {
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["phase","use","thermochemistry_available_at_reference"],
        "properties":{
          "phase":{"enum":["s","l","g","aq"]},
          "use":{"const":"teaching_selectable"},
          "thermochemistry_available_at_reference":{"type":"boolean"}
        }
      }
    },
    "source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "status":{"const":"published"}
  }
}
