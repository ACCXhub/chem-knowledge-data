{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/ACCXhub/chem-knowledge-data/packages/structure_registry/schema/structure-request.schema.json","title":"Cross-track Structure Request","description":"Template for requests stored in the caller's own package; callers must not write into packages/structure_registry.","type":"object","additionalProperties":false,"required":["schema_version","request_id","requester_track","local_entity_ref","status"],"properties":{"schema_version":{"const":"1.2.0"},"request_id":{"type":"string","pattern":"^sreq_[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},"requester_track":{"enum":["inorganic","organic","structural_chemistry","consolidation"]},"local_entity_ref":{"type":"string","minLength":1},"formula_hint":{"type":["string","null"]},"formal_charge_hint":{"type":["integer","null"]},"scope_hint":{"enum":["molecule","ion","formula_unit","polymer_repeat_unit","coordination_entity","crystal","other",null]},"external_id_hints":{"type":"array","items":{"type":"string","minLength":1},"default":[]},"status":{"enum":["requested","resolved","withdrawn"]},"resolved_structure_id":{"type":["string","null"],"pattern":"^str_[0-9a-f-]{36}$"},"notes":{"type":["string","null"]}}}
