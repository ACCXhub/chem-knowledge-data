{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ACCXhub/chem-knowledge-data/packages/structure/schema/structure-record.schema.json",
  "title": "Canonical Structure Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "structure_id",
    "structure_scope",
    "formal_charge",
    "validation",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "structure_id": {
      "type": "string",
      "pattern": "^str_[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "structure_scope": {
      "enum": ["molecule", "ion", "formula_unit", "coordination_entity", "crystal", "other"]
    },
    "molecular_formula": {"type": ["string", "null"], "minLength": 1},
    "formal_charge": {"type": "integer"},
    "canonical_smiles": {"type": ["string", "null"], "minLength": 1},
    "isomeric_smiles": {"type": ["string", "null"], "minLength": 1},
    "standard_inchi": {
      "type": ["string", "null"],
      "pattern": "^InChI=1S?/"
    },
    "standard_inchikey": {
      "type": ["string", "null"],
      "pattern": "^[A-Z]{14}-[A-Z]{10}-[A-Z]$"
    },
    "external_ids": {
      "type": "array",
      "items": {"$ref": "#/$defs/externalId"},
      "uniqueItems": true,
      "default": []
    },
    "derived": {"$ref": "#/$defs/derived"},
    "validation": {"$ref": "#/$defs/validation"},
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/provenance"}
    },
    "notes": {"type": ["string", "null"]}
  },
  "$defs": {
    "externalId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "value"],
      "properties": {
        "namespace": {"enum": ["pubchem_cid", "chebi", "other"]},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heavy_atom_count": {"type": "integer", "minimum": 0},
        "atom_count": {"type": "integer", "minimum": 0},
        "exact_mass": {"type": "number", "exclusiveMinimum": 0},
        "molecular_weight": {"type": "number", "exclusiveMinimum": 0},
        "toolkit": {"type": "string", "minLength": 1},
        "toolkit_version": {"type": "string", "minLength": 1}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "review_status"],
      "properties": {
        "status": {"enum": ["valid", "invalid", "unsupported", "needs_review"]},
        "review_status": {"enum": ["draft", "reviewed", "published", "rejected"]},
        "normalization_method": {"type": ["string", "null"]},
        "normalization_version": {"type": ["string", "null"]},
        "validated_at": {"type": ["string", "null"], "format": "date-time"},
        "issues": {
          "type": "array",
          "items": {"type": "string"},
          "default": []
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "record_locator", "retrieved_at", "supports"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "record_locator": {"type": "string", "minLength": 1},
        "source_url": {"type": ["string", "null"], "format": "uri"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "content_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "supports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "molecular_formula",
              "formal_charge",
              "canonical_smiles",
              "isomeric_smiles",
              "standard_inchi",
              "standard_inchikey",
              "external_ids",
              "derived"
            ]
          },
          "uniqueItems": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"structure_scope": {"enum": ["molecule", "ion"]}},
        "required": ["structure_scope"]
      },
      "then": {
        "anyOf": [
          {"required": ["canonical_smiles"]},
          {"required": ["standard_inchi"]}
        ]
      }
    }
  ]
}
