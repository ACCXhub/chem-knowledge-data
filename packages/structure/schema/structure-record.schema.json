{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ACCXhub/chem-knowledge-data/packages/structure/schema/structure-record.schema.json",
  "title": "StructureRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "structure_id",
    "structure_kind",
    "representation_scope",
    "review_status",
    "representations",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "structure_id": {
      "type": "string",
      "pattern": "^structure:[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "structure_kind": {
      "enum": [
        "atom",
        "discrete_molecule",
        "molecular_ion",
        "coordination_entity",
        "ionic_lattice",
        "network_solid",
        "molecular_solid",
        "unknown"
      ]
    },
    "representation_scope": {
      "enum": ["connectivity", "stereochemistry", "isotopic", "solid_state", "mixed_or_unknown"]
    },
    "molecular_formula": {"type": ["string", "null"], "minLength": 1},
    "formal_charge": {"type": ["integer", "null"]},
    "representations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "standard_inchi": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["value", "software_version"],
          "properties": {
            "value": {"type": "string", "pattern": "^InChI=1S/"},
            "software_version": {"type": "string", "minLength": 1}
          }
        },
        "standard_inchikey": {
          "type": ["string", "null"],
          "pattern": "^[A-Z]{14}-[A-Z]{10}-[A-Z]$"
        },
        "canonical_smiles": {"$ref": "#/$defs/toolkitSmiles"},
        "isomeric_smiles": {"$ref": "#/$defs/toolkitSmiles"},
        "crystal": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "external_id": {"type": ["string", "null"]},
            "cif_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
            "source_id": {"type": ["string", "null"]}
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parse_status": {"enum": ["not_applicable", "passed", "failed", "not_run"]},
        "valence_status": {"enum": ["not_applicable", "passed", "failed", "not_run"]},
        "formula_consistency": {"enum": ["not_applicable", "passed", "failed", "not_run"]},
        "charge_consistency": {"enum": ["not_applicable", "passed", "failed", "not_run"]},
        "notes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "review_status": {"enum": ["provisional", "validated", "published", "rejected"]},
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/provenanceAssertion"}
    }
  },
  "$defs": {
    "toolkitSmiles": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["value", "generator", "generator_version"],
      "properties": {
        "value": {"type": "string", "minLength": 1},
        "generator": {"type": "string", "minLength": 1},
        "generator_version": {"type": "string", "minLength": 1},
        "isomeric": {"type": "boolean"}
      }
    },
    "provenanceAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_locator", "retrieved_at", "evidence_type"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_record_id": {"type": ["string", "null"]},
        "source_locator": {"type": "string", "minLength": 1},
        "source_version": {"type": ["string", "null"]},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "content_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "license": {"type": ["string", "null"]},
        "evidence_type": {
          "enum": ["authoritative_standard", "curated_database", "aggregated_database", "experimental_structure", "computed_derivation", "manual_review"]
        }
      }
    }
  }
}
