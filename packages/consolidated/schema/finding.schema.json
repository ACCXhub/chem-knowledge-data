{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ACCXhub/chem-knowledge-data/packages/consolidated/schema/finding.schema.json",
  "title": "Consolidation finding",
  "type": "object",
  "required": ["id", "severity", "kind", "message", "source_refs"],
  "properties": {
    "id": {"type": "string", "minLength": 3},
    "severity": {"enum": ["info", "review", "blocking"]},
    "kind": {"type": "string", "minLength": 1},
    "message": {"type": "string", "minLength": 1},
    "source_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "details": {"type": ["object", "null"]}
  },
  "additionalProperties": false
}
