{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ACCXhub/chem-knowledge-data/packages/consolidated/schema/species.schema.json",
  "title": "Consolidated consumer species",
  "type": "object",
  "required": [
    "id",
    "entity_kind",
    "source_ids",
    "name_zh",
    "formula",
    "charge",
    "aliases",
    "teaching_priority",
    "integration_status",
    "provenance_refs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3,
      "description": "Stable opaque consolidated identity. Once published, it must not be reassigned."
    },
    "entity_kind": {
      "enum": ["ion", "substance"]
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["package", "id"],
        "properties": {
          "package": {"enum": ["inorganic", "organic"]},
          "id": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "name_zh": {"type": "string", "minLength": 1},
    "name_en": {"type": ["string", "null"]},
    "formula": {"type": "string", "minLength": 1},
    "charge": {"type": "integer"},
    "composition": {
      "type": ["object", "null"],
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "aliases": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "chemical_classifications": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "teaching_priority": {
      "enum": ["core", "common", "extended"]
    },
    "preferred_structure_id": {
      "type": ["string", "null"],
      "description": "Published packages/structure identity; Structure remains a separate canonical entity."
    },
    "external_ids": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["namespace", "value"],
        "properties": {
          "namespace": {"type": "string", "minLength": 1},
          "value": {"type": ["string", "integer"]}
        },
        "additionalProperties": false
      }
    },
    "integration_status": {
      "enum": ["resolved", "review_required"]
    },
    "provenance_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"entity_kind": {"const": "ion"}}},
      "then": {"required": ["charge"]}
    }
  ],
  "additionalProperties": false
}
