{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ACCXhub/chem-knowledge-data/packages/consolidated/schema/species.schema.json",
  "title": "Consolidated consumer species",
  "type": "object",
  "required": ["id", "entity_kind", "source_ids", "name_zh", "formula", "charge", "aliases", "chemical_classifications", "teaching_priority", "source_review_states", "integration_status", "provenance_refs", "external_ids"],
  "properties": {
    "id": {"type": "string", "minLength": 3},
    "entity_kind": {"enum": ["ion", "substance"]},
    "source_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "required": ["package", "id"],
        "properties": {"package": {"enum": ["inorganic", "organic"]}, "id": {"type": "string", "minLength": 1}},
        "additionalProperties": false
      }
    },
    "name_zh": {"type": "string", "minLength": 1},
    "name_en": {"type": ["string", "null"]},
    "formula": {"type": "string", "minLength": 1},
    "charge": {"type": "integer"},
    "composition": {"type": ["object", "null"], "additionalProperties": {"type": "integer", "minimum": 1}},
    "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "chemical_classifications": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "teaching_priority": {"enum": ["core", "common", "extended"]},
    "source_review_states": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["package", "state"], "properties": {"package": {"enum": ["inorganic", "organic"]}, "state": {"type": "string", "minLength": 1}}, "additionalProperties": false}
    },
    "preferred_structure_id": {"type": ["string", "null"], "description": "Published packages/structure_registry identity; Structure remains separate from species identity."},
    "external_ids": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "object", "required": ["namespace", "value"], "properties": {"namespace": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}}, "additionalProperties": false}
    },
    "integration_status": {"enum": ["resolved", "review_required"]},
    "provenance_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
