{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ACCXhub/chem-knowledge-data/packages/consolidated/schema/knowledge_link.schema.json",
  "title": "Resolved consolidated knowledge link",
  "type": "object",
  "required": ["id", "source_knowledge_id", "relation", "target_kind", "target_id", "resolution_method", "evidence_refs"],
  "properties": {
    "id": {"type": "string", "minLength": 3},
    "source_knowledge_id": {"type": "string", "minLength": 3},
    "relation": {"type": "string", "minLength": 1},
    "target_kind": {"enum": ["species", "structure", "element", "knowledge"]},
    "target_id": {"type": "string", "minLength": 1},
    "resolution_method": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
