{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ACCXhub/chem-knowledge-data/packages/consolidated/schema/structure-link.schema.json",
  "title": "Consolidated Species to Structure link",
  "type": "object",
  "additionalProperties": false,
  "required": ["species_id", "source_ref", "structure_id", "relation", "status", "evidence"],
  "properties": {
    "species_id": {"type": "string", "format": "uuid"},
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "local_id"],
      "properties": {
        "package": {"enum": ["inorganic", "organic"]},
        "local_id": {"type": "string", "minLength": 1}
      }
    },
    "structure_id": {"type": "string", "pattern": "^str_[0-9a-f-]{36}$"},
    "relation": {"enum": ["primary_structure", "ion_structure", "formula_unit", "component", "polymorph", "other"]},
    "status": {"enum": ["proposed", "accepted", "rejected"]},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "value"],
        "properties": {
          "kind": {"enum": ["external_id_match", "published_structure", "explicit_crossref", "reviewed_match"]},
          "namespace": {"type": ["string", "null"]},
          "value": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
