{
  "rule_set": "common_oxidation_states_hs_v1",
  "version": "1.0.0",
  "scope": "高中无机常见氧化态候选，用于命名、候选物种生成和氧化还原提示；不是对所有化合物的强制价态规则。",
  "elements": {
    "H": {"common":[1,-1],"default":1,"notes_zh":"金属氢化物中可为 -1。"},
    "O": {"common":[-2,-1],"default":-2,"notes_zh":"过氧化物中常为 -1。"},
    "F": {"common":[-1],"default":-1},
    "Cl": {"common":[-1,1,3,5,7],"default":-1},
    "Br": {"common":[-1,1,3,5,7],"default":-1},
    "I": {"common":[-1,1,3,5,7],"default":-1},
    "Na": {"common":[1],"default":1},
    "K": {"common":[1],"default":1},
    "Mg": {"common":[2],"default":2},
    "Ca": {"common":[2],"default":2},
    "Ba": {"common":[2],"default":2},
    "Al": {"common":[3],"default":3},
    "Zn": {"common":[2],"default":2},
    "Ag": {"common":[1],"default":1},
    "C": {"common":[-4,2,4],"default":null},
    "Si": {"common":[-4,4],"default":4},
    "N": {"common":[-3,1,2,3,4,5],"default":null},
    "P": {"common":[-3,3,5],"default":null},
    "S": {"common":[-2,0,4,6],"default":null},
    "Fe": {"common":[2,3],"default":null,"candidate_ion_ids":["ion:iron-ii","ion:iron-iii"]},
    "Cu": {"common":[1,2],"default":null,"candidate_ion_ids":["ion:copper-i","ion:copper-ii"]},
    "Mn": {"common":[2,4,6,7],"default":null,"candidate_ion_ids":["ion:manganese-ii","ion:manganate","ion:permanganate"]},
    "Cr": {"common":[3,6],"default":null,"candidate_ion_ids":["ion:chromium-iii","ion:chromate","ion:dichromate"]},
    "Sn": {"common":[2,4],"default":null,"candidate_ion_ids":["ion:tin-ii","ion:tin-iv"]},
    "Pb": {"common":[2,4],"default":null,"candidate_ion_ids":["ion:lead-ii","ion:lead-iv"]},
    "Hg": {"common":[1,2],"default":null},
    "Co": {"common":[2,3],"default":null},
    "Ni": {"common":[2,3],"default":null}
  },
  "composer_policy": "When default is null and more than one canonical oxidation state is plausible, return candidate species/ions instead of guessing a formula.",
  "sources": ["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]
}
