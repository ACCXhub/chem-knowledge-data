{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ACCXhub/chem-knowledge-data/packages/structural_chemistry/schema/record.schema.json",
  "title": "Structural Chemistry Knowledge Record",
  "type": "object",
  "required": ["id", "record_type", "topic_refs", "name_zh", "teaching_priority", "source_refs"],
  "properties": {
    "id": {"type": "string", "pattern": "^sc_[a-z0-9_\-]+$"},
    "record_type": {"enum": ["concept", "atomic_example", "molecular_geometry", "crystal_model", "coordination_example", "structure_property_relation"]},
    "topic_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^sc_topic_[a-z0-9_\-]+$"}, "uniqueItems": true},
    "name_zh": {"type": "string", "minLength": 1},
    "name_en": {"type": ["string", "null"]},
    "summary_zh": {"type": ["string", "null"]},
    "entity_ref": {
      "type": ["object", "null"],
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["structure_id", "species_id", "element_symbol", "formula", "concept_id"]},
        "value": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "structure_id": {"type": ["string", "null"], "pattern": "^str_[0-9a-f\-]+$"},
    "teaching_priority": {"enum": ["core", "common", "extended"]},
    "facts": {"type": "object"},
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["predicate", "target"],
        "properties": {
          "predicate": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "qualifier": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "teaching_notes": {"type": "array", "items": {"type": "string"}},
    "common_misconceptions": {"type": "array", "items": {"type": "string"}},
    "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^sc_src_[a-z0-9_\-]+$"}},
    "status": {"enum": ["draft", "reviewed", "published"]}
  },
  "additionalProperties": true
}
