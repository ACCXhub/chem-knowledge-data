{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Structural Chemistry Concept Relation",
  "type": "object",
  "required": ["id","entity_type","source_ref","relation_type","target_ref","source_refs","status"],
  "properties": {
    "id": {"type":"string","pattern":"^sc:relation:"},
    "entity_type": {"const":"concept_relation"},
    "source_ref": {"type":"string","pattern":"^sc:concept:"},
    "relation_type": {"type":"string","minLength":1},
    "target_ref": {"type":"string","pattern":"^sc:concept:"},
    "qualifier": {"type":"string"},
    "teaching_priority": {"enum":["core","common","extended"]},
    "source_refs": {"type":"array","items":{"type":"string"},"minItems":1,"uniqueItems":true},
    "status": {"const":"published"}
  },
  "additionalProperties": false
}
