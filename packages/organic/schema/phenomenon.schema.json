{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/chem-knowledge-data/organic/phenomenon.schema.json",
  "title": "Organic Phenomenon Seed Record",
  "type": "object",
  "required": ["id", "name_zh", "observation_zh", "verification_status", "provenance_refs"],
  "properties": {
    "id": {"type": "string", "pattern": "^org-phenomenon:[a-z0-9][a-z0-9-]*$"},
    "name_zh": {"type": "string", "minLength": 1},
    "observation_zh": {"type": "string", "minLength": 1},
    "interpretation_zh": {"type": ["string", "null"]},
    "diagnostic_strength": {"type": "string", "enum": ["supporting", "typical", "not_unique"]},
    "reaction_refs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^org-reaction:[a-z0-9][a-z0-9-]*$"},
      "uniqueItems": true
    },
    "experiment_refs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^org-experiment:[a-z0-9][a-z0-9-]*$"},
      "uniqueItems": true
    },
    "verification_status": {"type": "string", "enum": ["seed", "source_crosschecked", "reviewed"]},
    "provenance_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
