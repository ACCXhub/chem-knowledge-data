{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/chem-knowledge-data/organic/identity_crossref.schema.json",
  "title": "Organic Substance External Identity Cross-reference",
  "type": "object",
  "required": ["substance_ref", "verification_status", "provenance_refs"],
  "properties": {
    "substance_ref": {"type": "string", "pattern": "^org-substance:[a-z0-9][a-z0-9-]*$"},
    "pubchem_cid": {"type": ["integer", "null"], "minimum": 1},
    "chebi_id": {"type": ["string", "null"], "pattern": "^CHEBI:[0-9]+$"},
    "verification_status": {"type": "string", "enum": ["source_crosschecked", "reviewed"]},
    "provenance_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
