{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/chem-knowledge-data/organic/experiment.schema.json",
  "title": "Organic Experiment Seed Record",
  "type": "object",
  "required": ["id", "name_zh", "purpose_zh", "reaction_refs", "phenomenon_refs", "safety_level", "verification_status", "provenance_refs"],
  "properties": {
    "id": {"type": "string", "pattern": "^org-experiment:[a-z0-9][a-z0-9-]*$"},
    "name_zh": {"type": "string", "minLength": 1},
    "purpose_zh": {"type": "string", "minLength": 1},
    "reaction_refs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^org-reaction:[a-z0-9][a-z0-9-]*$"},
      "uniqueItems": true
    },
    "phenomenon_refs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^org-phenomenon:[a-z0-9][a-z0-9-]*$"},
      "uniqueItems": true
    },
    "procedure_scope": {
      "type": "string",
      "enum": ["observation_only", "teacher_demo", "student_experiment", "conceptual"]
    },
    "safety_level": {"type": "string", "enum": ["routine", "controlled", "teacher_only"]},
    "safety_notes_zh": {"type": "array", "items": {"type": "string"}},
    "verification_status": {"type": "string", "enum": ["seed", "source_crosschecked", "reviewed"]},
    "provenance_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
