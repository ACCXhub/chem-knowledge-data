{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ACCXhub/chem-knowledge-data/packages/inorganic/schema/catalog.schema.json",
  "title": "Chem Knowledge Data inorganic record",
  "oneOf": [
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Element teaching projection",
      "type": "object",
      "required": ["id","kind","symbol","atomic_number","name_zh","teaching_priority","review_status","sources"],
      "properties": {
        "id": {"type":"string","minLength":3},
        "kind": {"const":"element_scope"},
        "name_zh": {"type":"string","minLength":1},
        "teaching_priority": {"enum":["core","common","extended"]},
        "review_status": {"enum":["seed","reviewed","published"]},
        "sources": {"type":"array","items":{"type":"string"},"minItems":1,"uniqueItems":true},
        "symbol": {"type":"string","pattern":"^[A-Z][a-z]?$"},
        "atomic_number": {"type":"integer","minimum":1,"maximum":118},
        "curriculum_groups": {"type":"array","items":{"type":"string"}}
      },
      "additionalProperties": true
    },
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Ion",
      "type": "object",
      "required": ["id","kind","name_zh","name_en","formula","charge","composition","ion_type","teaching_priority","review_status","sources"],
      "properties": {
        "id": {"type":"string","minLength":3},
        "kind": {"const":"ion"},
        "name_zh": {"type":"string","minLength":1},
        "teaching_priority": {"enum":["core","common","extended"]},
        "review_status": {"enum":["seed","reviewed","published"]},
        "sources": {"type":"array","items":{"type":"string"},"minItems":1,"uniqueItems":true},
        "name_en": {"type":"string"},
        "formula": {"type":"string"},
        "charge": {"type":"integer"},
        "composition": {"type":"object","additionalProperties":{"type":"integer","minimum":1}},
        "ion_type": {"enum":["monatomic","polyatomic"]},
        "aliases": {"type":"array","items":{"type":"string"}},
        "verification_targets": {"type":"array","items":{"type":"string"}}
      },
      "additionalProperties": true
    },
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Substance",
      "type": "object",
      "required": ["id","kind","name_zh","name_en","formula","composition","category","ambient_phase","teaching_priority","review_status","sources"],
      "properties": {
        "id": {"type":"string","minLength":3},
        "kind": {"const":"substance"},
        "name_zh": {"type":"string","minLength":1},
        "teaching_priority": {"enum":["core","common","extended"]},
        "review_status": {"enum":["seed","reviewed","published"]},
        "sources": {"type":"array","items":{"type":"string"},"minItems":1,"uniqueItems":true},
        "name_en": {"type":"string"},
        "formula": {"type":"string"},
        "composition": {"type":"object","additionalProperties":{"type":"integer","minimum":1}},
        "category": {"type":"string"},
        "ambient_phase": {"enum":["s","l","g","aq"]},
        "aqueous_behavior": {"type":["string","null"]},
        "ions": {"type":"array"},
        "aliases": {"type":"array","items":{"type":"string"}},
        "verification_targets": {"type":"array","items":{"type":"string"}}
      },
      "additionalProperties": true
    },
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Reaction",
      "type": "object",
      "required": ["id","kind","name_zh","reactants","products","reaction_types","conditions","phenomenon_ids","teaching_priority","review_status","sources"],
      "properties": {
        "id": {"type":"string","minLength":3},
        "kind": {"const":"reaction"},
        "name_zh": {"type":"string","minLength":1},
        "teaching_priority": {"enum":["core","common","extended"]},
        "review_status": {"enum":["seed","reviewed","published"]},
        "sources": {"type":"array","items":{"type":"string"},"minItems":1,"uniqueItems":true},
        "reactants": {"type":"array","minItems":1},
        "products": {"type":"array","minItems":1},
        "reaction_types": {"type":"array","items":{"type":"string"},"minItems":1},
        "conditions": {"type":"array","items":{"type":"string"}},
        "phenomenon_ids": {"type":"array","items":{"type":"string"}},
        "reversible": {"type":"boolean"},
        "net_ionic": {"type":["object","null"]}
      },
      "additionalProperties": true
    },
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Phenomenon",
      "type": "object",
      "required": ["id","kind","name_zh","category","observation_zh","related_reaction_ids","teaching_priority","review_status","sources"],
      "properties": {
        "id": {"type":"string","minLength":3},
        "kind": {"const":"phenomenon"},
        "name_zh": {"type":"string","minLength":1},
        "teaching_priority": {"enum":["core","common","extended"]},
        "review_status": {"enum":["seed","reviewed","published"]},
        "sources": {"type":"array","items":{"type":"string"},"minItems":1,"uniqueItems":true},
        "category": {"type":"string"},
        "observation_zh": {"type":"string"},
        "related_reaction_ids": {"type":"array","items":{"type":"string"}}
      },
      "additionalProperties": true
    },
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Experiment",
      "type": "object",
      "required": ["id","kind","name_zh","purpose_zh","reaction_ids","delivery_mode","safety_notes_zh","expected_phenomenon_ids","teaching_priority","review_status","sources"],
      "properties": {
        "id": {"type":"string","minLength":3},
        "kind": {"const":"experiment"},
        "name_zh": {"type":"string","minLength":1},
        "teaching_priority": {"enum":["core","common","extended"]},
        "review_status": {"enum":["seed","reviewed","published"]},
        "sources": {"type":"array","items":{"type":"string"},"minItems":1,"uniqueItems":true},
        "purpose_zh": {"type":"string"},
        "reaction_ids": {"type":"array","items":{"type":"string"}},
        "delivery_mode": {"enum":["student","teacher_demo"]},
        "safety_notes_zh": {"type":"array","items":{"type":"string"}},
        "expected_phenomenon_ids": {"type":"array","items":{"type":"string"}}
      },
      "additionalProperties": true
    },
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Concept",
      "type": "object",
      "required": ["id","kind","name_zh","definition_zh","related_reaction_ids","related_species_ids","teaching_priority","review_status","sources"],
      "properties": {
        "id": {"type":"string","minLength":3},
        "kind": {"const":"concept"},
        "name_zh": {"type":"string","minLength":1},
        "teaching_priority": {"enum":["core","common","extended"]},
        "review_status": {"enum":["seed","reviewed","published"]},
        "sources": {"type":"array","items":{"type":"string"},"minItems":1,"uniqueItems":true},
        "definition_zh": {"type":"string"},
        "related_reaction_ids": {"type":"array","items":{"type":"string"}},
        "related_species_ids": {"type":"array","items":{"type":"string"}},
        "tags": {"type":"array","items":{"type":"string"}}
      },
      "additionalProperties": true
    }
  ]
}
