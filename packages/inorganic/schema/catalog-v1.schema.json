{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ACCXhub/chem-knowledge-data/packages/inorganic/schema/catalog-v1.schema.json",
  "title": "High-school inorganic canonical record v1",
  "$defs": {
    "base": {
      "type": "object",
      "required": ["id", "kind", "teaching_priority", "review_status", "sources"],
      "properties": {
        "id": {"type": "string", "minLength": 3},
        "kind": {"type": "string"},
        "teaching_priority": {"enum": ["core", "common", "extended"]},
        "review_status": {"enum": ["seed", "reviewed", "published"]},
        "sources": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "verification_targets": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "composition": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "participant": {
      "type": "object",
      "required": ["species_id", "coefficient", "phase"],
      "properties": {
        "species_id": {"type": "string"},
        "coefficient": {"type": "integer", "minimum": 1},
        "phase": {"enum": ["s", "l", "g", "aq"]}
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "required": ["symbol", "atomic_number", "name_zh"],
          "properties": {
            "kind": {"const": "element_scope"},
            "symbol": {"type": "string", "pattern": "^[A-Z][a-z]?$"},
            "atomic_number": {"type": "integer", "minimum": 1, "maximum": 118},
            "name_zh": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "required": ["name_zh", "name_en", "formula", "charge", "composition", "ion_type"],
          "properties": {
            "kind": {"const": "ion"},
            "name_zh": {"type": "string"},
            "name_en": {"type": "string"},
            "formula": {"type": "string"},
            "charge": {"type": "integer", "not": {"const": 0}},
            "composition": {"$ref": "#/$defs/composition"},
            "ion_type": {"enum": ["monatomic", "polyatomic"]}
          }
        }
      ]
    },
    {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "required": ["name_zh", "name_en", "formula", "composition", "category", "ambient_phase", "ions"],
          "properties": {
            "kind": {"const": "substance"},
            "name_zh": {"type": "string"},
            "name_en": {"type": "string"},
            "formula": {"type": "string"},
            "composition": {"$ref": "#/$defs/composition"},
            "category": {"type": "string"},
            "ambient_phase": {"enum": ["s", "l", "g", "aq"]},
            "aqueous_behavior": {"type": ["string", "null"]},
            "ions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["ion_id", "coefficient"],
                "properties": {
                  "ion_id": {"type": "string"},
                  "coefficient": {"type": "integer", "minimum": 1}
                },
                "additionalProperties": false
              }
            }
          }
        }
      ]
    },
    {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "required": ["name_zh", "reactants", "products", "reaction_types", "conditions", "phenomenon_ids", "reversible"],
          "properties": {
            "kind": {"const": "reaction"},
            "name_zh": {"type": "string"},
            "reactants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/participant"}},
            "products": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/participant"}},
            "reaction_types": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "conditions": {"type": "array", "items": {"type": "string"}},
            "phenomenon_ids": {"type": "array", "items": {"type": "string"}},
            "net_ionic": {"type": ["object", "null"]},
            "reversible": {"type": "boolean"}
          }
        }
      ]
    },
    {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "required": ["name_zh", "category", "observation_zh", "related_reaction_ids"],
          "properties": {
            "kind": {"const": "phenomenon"},
            "name_zh": {"type": "string"},
            "category": {"type": "string"},
            "observation_zh": {"type": "string"},
            "related_reaction_ids": {"type": "array", "items": {"type": "string"}}
          }
        }
      ]
    },
    {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "required": ["name_zh", "purpose_zh", "reaction_ids", "delivery_mode", "safety_notes_zh", "expected_phenomenon_ids"],
          "properties": {
            "kind": {"const": "experiment"},
            "name_zh": {"type": "string"},
            "purpose_zh": {"type": "string"},
            "reaction_ids": {"type": "array", "items": {"type": "string"}},
            "delivery_mode": {"enum": ["student", "teacher_demo"]},
            "safety_notes_zh": {"type": "array", "items": {"type": "string"}},
            "expected_phenomenon_ids": {"type": "array", "items": {"type": "string"}}
          }
        }
      ]
    },
    {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "required": ["name_zh", "definition_zh", "related_reaction_ids", "related_species_ids"],
          "properties": {
            "kind": {"const": "concept"},
            "name_zh": {"type": "string"},
            "definition_zh": {"type": "string"},
            "related_reaction_ids": {"type": "array", "items": {"type": "string"}},
            "related_species_ids": {"type": "array", "items": {"type": "string"}}
          }
        }
      ]
    },
    {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "required": ["name_zh", "description_zh", "related_concept_ids"],
          "properties": {
            "kind": {"const": "exam_tag"},
            "name_zh": {"type": "string"},
            "description_zh": {"type": "string"},
            "related_concept_ids": {"type": "array", "items": {"type": "string"}}
          }
        }
      ]
    }
  ]
}
