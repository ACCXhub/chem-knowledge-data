{
  "rule_set": "inorganic_solubility_hs_v1",
  "version": "1.0.1",
  "scope": "高中水溶液常见离子反应的教学级溶解性判断；用于候选生成和方程式提示，不替代温度依赖溶解度数据。",
  "priority": [
    "exact_override",
    "cation_or_anion_family",
    "default_unknown"
  ],
  "rules": [
    {
      "id": "sol:nitrate",
      "match": {"anion": "ion:nitrate"},
      "result": "soluble",
      "summary_zh": "常见硝酸盐可溶。"
    },
    {
      "id": "sol:alkali",
      "match": {"cation_any": ["ion:sodium", "ion:potassium"]},
      "result": "soluble",
      "summary_zh": "高中常见钠盐、钾盐通常可溶；锂盐按具体阴离子规则判断。"
    },
    {
      "id": "sol:ammonium",
      "match": {"cation": "ion:ammonium"},
      "result": "soluble",
      "summary_zh": "常见铵盐可溶。"
    },
    {
      "id": "sol:chloride",
      "match": {"anion": "ion:chloride"},
      "result": "soluble",
      "exceptions": [
        {"substance_id": "substance:silver-chloride", "result": "insoluble"},
        {"substance_id": "substance:lead-chloride", "result": "sparingly_soluble"},
        {"substance_id": "substance:copper-i-chloride", "result": "insoluble"}
      ],
      "summary_zh": "多数氯化物可溶；AgCl、CuCl 难溶，PbCl2 微溶。"
    },
    {
      "id": "sol:bromide-iodide",
      "match": {"anion_any": ["ion:bromide", "ion:iodide"]},
      "result": "soluble",
      "exceptions": [
        {"substance_id": "substance:silver-bromide", "result": "insoluble"},
        {"substance_id": "substance:silver-iodide", "result": "insoluble"},
        {"substance_id": "substance:lead-iodide", "result": "insoluble"}
      ],
      "summary_zh": "多数溴化物、碘化物可溶，银盐及部分铅盐为典型难溶例外。"
    },
    {
      "id": "sol:sulfate",
      "match": {"anion": "ion:sulfate"},
      "result": "soluble",
      "exceptions": [
        {"substance_id": "substance:barium-sulfate", "result": "insoluble"},
        {"substance_id": "substance:lead-sulfate", "result": "insoluble"},
        {"substance_id": "substance:calcium-sulfate", "result": "sparingly_soluble"},
        {"substance_id": "substance:strontium-sulfate", "result": "insoluble"}
      ],
      "summary_zh": "多数硫酸盐可溶，BaSO4、PbSO4、SrSO4 等难溶，CaSO4 微溶。"
    },
    {
      "id": "sol:lithium-carbonate",
      "match": {"cation": "ion:lithium", "anion": "ion:carbonate"},
      "result": "sparingly_soluble",
      "summary_zh": "Li2CO3 在水中的溶解度较低，不套用一般碱金属盐可溶的简化结论。"
    },
    {
      "id": "sol:calcium-fluoride",
      "match": {"cation": "ion:calcium", "anion": "ion:fluoride"},
      "result": "insoluble",
      "summary_zh": "CaF2 难溶，作为高中常见含氟沉淀的明确例外记录。"
    },
    {
      "id": "sol:calcium-hydrogen-sulfite",
      "match": {"cation": "ion:calcium", "anion": "ion:hydrogen-sulfite"},
      "result": "soluble",
      "summary_zh": "高中二氧化硫过量体系中 Ca(HSO3)2 按可溶水溶液物种处理。"
    },
    {
      "id": "sol:hydrogen-carbonate",
      "match": {"anion": "ion:hydrogen-carbonate"},
      "result": "soluble",
      "summary_zh": "高中常见碳酸氢盐按可溶体系处理，支持过量 CO2 与碳酸盐转化。"
    },
    {
      "id": "sol:carbonate",
      "match": {"anion": "ion:carbonate"},
      "result": "insoluble",
      "exceptions_by_cation": [
        {"cation_any": ["ion:sodium", "ion:potassium", "ion:ammonium"], "result": "soluble"}
      ],
      "summary_zh": "多数碳酸盐难溶；Na+、K+、NH4+ 的常见碳酸盐可溶，Li2CO3 溶解度较低，单独按微溶规则处理。"
    },
    {
      "id": "sol:phosphate",
      "match": {"anion": "ion:phosphate"},
      "result": "insoluble",
      "exceptions_by_cation": [
        {"cation_any": ["ion:sodium", "ion:potassium", "ion:ammonium"], "result": "soluble"}
      ],
      "summary_zh": "多数磷酸盐难溶，常见碱金属和铵盐可溶。"
    },
    {
      "id": "sol:sulfite",
      "match": {"anion": "ion:sulfite"},
      "result": "insoluble",
      "exceptions_by_cation": [
        {"cation_any": ["ion:sodium", "ion:potassium", "ion:ammonium"], "result": "soluble"}
      ],
      "summary_zh": "多数亚硫酸盐难溶，常见碱金属和铵盐可溶。"
    },
    {
      "id": "sol:silicate",
      "match": {"anion": "ion:silicate"},
      "result": "insoluble",
      "exceptions_by_cation": [
        {"cation_any": ["ion:sodium", "ion:potassium"], "result": "soluble"}
      ],
      "summary_zh": "多数硅酸盐难溶，常见碱金属硅酸盐可溶。"
    },
    {
      "id": "sol:hydroxide",
      "match": {"anion": "ion:hydroxide"},
      "result": "insoluble",
      "exceptions": [
        {"substance_id": "substance:sodium-hydroxide", "result": "soluble"},
        {"substance_id": "substance:potassium-hydroxide", "result": "soluble"},
        {"substance_id": "substance:barium-hydroxide", "result": "soluble"},
        {"substance_id": "substance:calcium-hydroxide", "result": "sparingly_soluble"}
      ],
      "summary_zh": "多数金属氢氧化物难溶；NaOH、KOH、Ba(OH)2 可溶，Ca(OH)2 微溶且其溶解部分按强电解质处理。"
    },
    {
      "id": "sol:sulfide",
      "match": {"anion": "ion:sulfide"},
      "result": "insoluble",
      "exceptions_by_cation": [
        {"cation_any": ["ion:sodium", "ion:potassium", "ion:ammonium"], "result": "soluble"}
      ],
      "summary_zh": "高中常见过渡金属硫化物多难溶，碱金属和铵盐可溶。"
    }
  ],
  "unknown_policy": "unknown",
  "sources": ["src:editorial-hs-inorganic-v1", "src:moe-hs-chem-2020"]
}
