{"id":"concept:phosphorus","kind":"concept","name_zh":"磷及其化合物","definition_zh":"以磷单质、磷的氧化物、磷酸及磷酸盐的典型性质和转化为主线。","teaching_priority":"core","related_reaction_ids":["reaction:phosphorus-combustion","reaction:p4o10-water","reaction:h3po4-naoh-full"],"related_species_ids":["substance:phosphorus","substance:phosphoric-acid"],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:silicon","kind":"concept","name_zh":"硅及其化合物","definition_zh":"以 Si、SiO2、硅酸和硅酸盐为代表理解硅元素在无机材料和非金属化学中的典型性质。","teaching_priority":"core","related_reaction_ids":["reaction:sio2-naoh","reaction:sodium-silicate-hcl","reaction:silicon-chlorine"],"related_species_ids":["substance:silicon-dioxide","substance:sodium-silicate"],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:halogen-periodicity","kind":"concept","name_zh":"卤素性质递变","definition_zh":"同主族卤素单质的氧化性总体随原子序数增大而减弱，可通过卤素置换反应比较。","teaching_priority":"core","related_reaction_ids":["reaction:chlorine-kbr","reaction:chlorine-ki","reaction:bromine-ki"],"related_species_ids":[],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:nitric-acid-oxidizing","kind":"concept","name_zh":"硝酸的氧化性","definition_zh":"硝酸除具有酸性外还具有强氧化性，与金属等物质反应时含氮还原产物受浓度等条件影响。","teaching_priority":"core","related_reaction_ids":["reaction:copper-conc-hno3","reaction:copper-dilute-hno3"],"related_species_ids":["substance:nitric-acid"],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:concentrated-sulfuric-acid","kind":"concept","name_zh":"浓硫酸的特性","definition_zh":"浓硫酸具有强酸性、吸水性、脱水性和较强氧化性；具体表现取决于反应物和条件。","teaching_priority":"core","related_reaction_ids":["reaction:copper-conc-h2so4","reaction:carbon-conc-h2so4","reaction:sulfur-conc-h2so4"],"related_species_ids":["substance:sulfuric-acid"],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:ammonia-ammonium","kind":"concept","name_zh":"氨与铵盐","definition_zh":"氨是弱碱性分子，铵根是其共轭酸；铵盐与强碱作用可释放氨气。","teaching_priority":"core","related_reaction_ids":["reaction:ammonia-lab-preparation","reaction:nh4cl-naoh","reaction:ammonia-nitric-acid"],"related_species_ids":["substance:ammonia","ion:ammonium"],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:complex-ion","kind":"concept","name_zh":"配合离子与配合反应","definition_zh":"中心离子与配体通过配位作用形成配合粒子；高中阶段主要用于解释特征显色、沉淀溶解等现象。","teaching_priority":"common","related_reaction_ids":["reaction:fecl3-kscn","reaction:alcl3-naoh-excess"],"related_species_ids":[],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:qualitative-analysis","kind":"concept","name_zh":"无机离子定性检验","definition_zh":"利用特征沉淀、显色、气体或其他选择性反应识别待测离子，并关注干扰和操作顺序。","teaching_priority":"core","related_reaction_ids":["reaction:agno3-kbr","reaction:agno3-ki","reaction:fecl3-kscn","reaction:nh4cl-naoh"],"related_species_ids":[],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:hydrolysis-inorganic","kind":"concept","name_zh":"无机物水解","definition_zh":"某些盐、卤化物、氮化物等与水发生反应或离子水解，生成酸、碱、沉淀或气体。","teaching_priority":"common","related_reaction_ids":["reaction:silicon-tetrachloride-water","reaction:mg3n2-water","reaction:aln-water"],"related_species_ids":[],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:peroxide","kind":"concept","name_zh":"过氧化物","definition_zh":"过氧化物含有过氧键或过氧根特征，在高中无机反应中常表现出特殊的氧化还原行为。","teaching_priority":"common","related_reaction_ids":["reaction:h2o2-decomposition","reaction:na2o2-water","reaction:na2o2-co2"],"related_species_ids":["substance:hydrogen-peroxide","substance:sodium-peroxide"],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:metallurgy","kind":"concept","name_zh":"金属冶炼的化学原理","definition_zh":"依据金属活动性和矿石组成选择还原、热分解或电解等方法获得金属。","teaching_priority":"core","related_reaction_ids":["reaction:fe2o3-co","reaction:fe3o4-co"],"related_species_ids":["substance:iron"],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:thermal-decomposition","kind":"concept","name_zh":"受热分解规律","definition_zh":"部分碳酸盐、碳酸氢盐、含氧酸盐、过氧化物等受热时发生分解，产物与稳定性有关。","teaching_priority":"core","related_reaction_ids":["reaction:caco3-thermal","reaction:nahco3-thermal","reaction:kclo3-thermal","reaction:kmno4-thermal"],"related_species_ids":[],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:chemical-equilibrium","kind":"concept","name_zh":"化学平衡","definition_zh":"在一定条件下可逆反应的正、逆反应速率相等，体系宏观组成保持相对稳定的动态状态。","teaching_priority":"core","related_reaction_ids":["reaction:haber-ammonia","reaction:sulfur-dioxide-oxidation","reaction:no2-dimerization"],"related_species_ids":[],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:le-chatelier","kind":"concept","name_zh":"化学平衡移动","definition_zh":"改变浓度、压强或温度等条件后，平衡体系会发生新的动态调整；应根据具体反应分析移动方向。","teaching_priority":"core","related_reaction_ids":["reaction:haber-ammonia","reaction:chromate-acid-dichromate","reaction:no2-dimerization"],"related_species_ids":[],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:reaction-rate","kind":"concept","name_zh":"化学反应速率","definition_zh":"用单位时间内反应物或生成物浓度等量的变化描述反应进行快慢，受浓度、温度、催化剂和接触面积等影响。","teaching_priority":"core","related_reaction_ids":["reaction:na2s2o3-hcl","reaction:h2o2-decomposition"],"related_species_ids":[],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:catalyst","kind":"concept","name_zh":"催化剂","definition_zh":"能改变反应速率而在反应前后总体组成和质量不被消耗的物质；催化剂改变反应路径但不改变平衡常数。","teaching_priority":"core","related_reaction_ids":["reaction:h2o2-decomposition","reaction:kclo3-thermal","reaction:ammonia-catalytic-oxidation"],"related_species_ids":[],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:activation-energy","kind":"concept","name_zh":"活化能与反应路径","definition_zh":"反应发生需要跨越能垒；催化剂通过提供不同反应路径降低有效活化能，从而改变反应速率。","teaching_priority":"common","related_reaction_ids":[],"related_species_ids":[],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:reaction-enthalpy","kind":"concept","name_zh":"反应焓变","definition_zh":"恒压条件下反应体系的焓变化可用于表示化学反应吸收或释放的热量，常记为 ΔH。","teaching_priority":"core","related_reaction_ids":["reaction:hydrogen-combustion","reaction:carbon-complete-combustion"],"related_species_ids":[],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:exo-endo","kind":"concept","name_zh":"放热反应与吸热反应","definition_zh":"依据体系与环境之间热量传递方向，可将反应区分为放热反应和吸热反应。","teaching_priority":"core","related_reaction_ids":["reaction:hydrogen-combustion","reaction:cao-water","reaction:caco3-thermal"],"related_species_ids":[],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:thermochemical-equation","kind":"concept","name_zh":"热化学方程式","definition_zh":"在化学方程式基础上明确物质状态、计量系数和对应焓变，用于定量表达反应热效应。","teaching_priority":"core","related_reaction_ids":[],"related_species_ids":[],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:weak-electrolyte-ionization","kind":"concept","name_zh":"弱电解质电离平衡","definition_zh":"弱酸、弱碱等在水中仅部分电离并建立动态平衡，平衡受浓度、温度和共同离子等因素影响。","teaching_priority":"core","related_reaction_ids":["reaction:co2-water","reaction:so2-water"],"related_species_ids":["substance:carbonic-acid","substance:ammonia"],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:ionization-constant","kind":"concept","name_zh":"电离常数","definition_zh":"在一定温度下，弱电解质电离平衡可用酸、碱电离常数定量描述其电离程度和强弱。","teaching_priority":"core","related_reaction_ids":[],"related_species_ids":[],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:water-autoionization","kind":"concept","name_zh":"水的电离与离子积","definition_zh":"水会发生极弱的自偶电离，在一定温度下 H+ 与 OH- 浓度乘积具有确定关系。","teaching_priority":"core","related_reaction_ids":["reaction:hcl-naoh"],"related_species_ids":["substance:water","ion:hydrogen","ion:hydroxide"],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:ph","kind":"concept","name_zh":"pH 与溶液酸碱性","definition_zh":"pH 用于表示稀水溶液中氢离子活度的数量级，高中近似计算常以氢离子浓度处理。","teaching_priority":"core","related_reaction_ids":[],"related_species_ids":["ion:hydrogen","ion:hydroxide"],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:acid-base-indicator","kind":"concept","name_zh":"酸碱指示剂","definition_zh":"酸碱指示剂在不同 pH 范围呈现不同颜色，可用于判断溶液酸碱性和滴定终点附近的变化。","teaching_priority":"core","related_reaction_ids":[],"related_species_ids":[],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:acid-base-titration","kind":"concept","name_zh":"酸碱中和滴定","definition_zh":"用已知浓度的标准溶液与待测酸或碱按化学计量关系反应，通过终点判断求得待测浓度。","teaching_priority":"core","related_reaction_ids":["reaction:hcl-naoh","reaction:h2so4-naoh"],"related_species_ids":[],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:salt-hydrolysis","kind":"concept","name_zh":"盐类水解","definition_zh":"由弱酸或弱碱形成的离子可与水发生质子转移，使盐溶液呈酸性或碱性。","teaching_priority":"core","related_reaction_ids":[],"related_species_ids":[],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:buffer-solution","kind":"concept","name_zh":"缓冲溶液","definition_zh":"由适当弱酸/共轭碱或弱碱/共轭酸组成的体系可减小少量酸碱加入造成的 pH 变化。","teaching_priority":"common","related_reaction_ids":[],"related_species_ids":[],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1"]}
{"id":"concept:solubility-equilibrium","kind":"concept","name_zh":"难溶电解质的溶解平衡","definition_zh":"难溶盐在水中仍存在微量溶解与结晶的动态平衡，可用离子浓度关系描述。","teaching_priority":"core","related_reaction_ids":["reaction:agno3-nacl","reaction:bacl2-na2so4","reaction:agno3-ki"],"related_species_ids":["substance:silver-chloride","substance:barium-sulfate"],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:ksp","kind":"concept","name_zh":"溶度积","definition_zh":"在一定温度下，难溶电解质饱和溶液中相关离子活度幂的乘积为溶度积常数，可用于判断沉淀与溶解趋势。","teaching_priority":"core","related_reaction_ids":[],"related_species_ids":[],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:galvanic-cell","kind":"concept","name_zh":"原电池","definition_zh":"自发氧化还原反应可在空间分离的两个电极上进行，将化学能转化为电能。","teaching_priority":"core","related_reaction_ids":["reaction:zinc-cuso4"],"related_species_ids":["substance:zinc","substance:copper"],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:electrode-reaction","kind":"concept","name_zh":"电极反应","definition_zh":"电化学装置中氧化和还原分别发生在不同电极，电极反应式需同时满足原子与电荷守恒。","teaching_priority":"core","related_reaction_ids":[],"related_species_ids":[],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:electrolysis","kind":"concept","name_zh":"电解池与电解","definition_zh":"外加电源驱动非自发氧化还原过程，阳极发生氧化、阴极发生还原。","teaching_priority":"core","related_reaction_ids":[],"related_species_ids":[],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:electroplating-refining","kind":"concept","name_zh":"电镀与电解精炼","definition_zh":"利用电解控制金属在阴极沉积，可用于表面镀层和金属纯化。","teaching_priority":"common","related_reaction_ids":[],"related_species_ids":["substance:copper","ion:copper-ii"],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:corrosion-protection","kind":"concept","name_zh":"金属腐蚀与防护","definition_zh":"金属腐蚀常涉及氧化还原与电化学过程，可通过隔绝介质、牺牲阳极或外加电流等方法减缓。","teaching_priority":"core","related_reaction_ids":[],"related_species_ids":["substance:iron","substance:zinc"],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:mole","kind":"concept","name_zh":"物质的量","definition_zh":"物质的量以摩尔为单位，把微观粒子数与宏观可测量量联系起来，是化学计量的核心量。","teaching_priority":"core","related_reaction_ids":[],"related_species_ids":[],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:avogadro-constant","kind":"concept","name_zh":"阿伏加德罗常数","definition_zh":"1 mol 指定微粒所含的实体数由阿伏加德罗常数给出，用于粒子数和物质的量之间的换算。","teaching_priority":"core","related_reaction_ids":[],"related_species_ids":[],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:molar-gas-volume","kind":"concept","name_zh":"气体摩尔体积","definition_zh":"在给定温度和压强下，理想气体摩尔体积取决于状态条件；计算时必须明确温度和压强。","teaching_priority":"core","related_reaction_ids":[],"related_species_ids":[],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:molar-concentration","kind":"concept","name_zh":"物质的量浓度","definition_zh":"单位体积溶液中所含溶质的物质的量，用于描述溶液组成并连接溶液反应的化学计量。","teaching_priority":"core","related_reaction_ids":[],"related_species_ids":[],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:colloid","kind":"concept","name_zh":"胶体与分散系","definition_zh":"按分散质粒子尺度可区分溶液、胶体和浊液；胶体具有丁达尔效应等典型性质。","teaching_priority":"core","related_reaction_ids":["reaction:sodium-silicate-hcl"],"related_species_ids":[],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
{"id":"concept:periodic-law","kind":"concept","name_zh":"元素周期律与周期表","definition_zh":"元素性质随原子序数呈周期性变化，可结合电子层结构、周期和族理解金属性、非金属性等递变。","teaching_priority":"core","related_reaction_ids":["reaction:chlorine-kbr","reaction:bromine-ki"],"related_species_ids":[],"tags":[],"review_status":"reviewed","sources":["src:editorial-hs-inorganic-v1","src:moe-hs-chem-2020"]}
